# Environment files
.env
.env.local
.env.*.local

# Database
data/*.db
data/*.sqlite
data/*.db-wal
data/*.db-shm

# Uploaded bookkeeping invoices - real financial documents, never commit them.
# The directory and its .htaccess are recreated automatically on first use.
data/bookkeeping_pdfs/

# Uploaded profile pictures - personal data, same story.
data/avatars/

# Local development helpers and test credentials - never commit them.
# dev/ holds seeded accounts whose passwords are written down in plain text;
# they are only safe on a machine that is not reachable from anywhere else.
dev/

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp

# Vendor dependencies - now included for PhpSpreadsheet
# vendor/

# Node modules (if using npm later)
node_modules/
