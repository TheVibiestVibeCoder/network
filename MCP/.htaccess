# Deny all direct web access to this directory.
# This is the MCP server's source code. It runs on its own machine and is only
# in the CRM repository for convenience - the CRM's web server must never
# serve it. (Harmless in the MCP server's own repository.)
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

# Belt and braces: if the deny directives above are not honoured, make sure
# nothing in here is ever handed to the PHP interpreter or served as text.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^ - [F,L]
</IfModule>

# php_flag is a mod_php directive - an unguarded one would make the whole
# directory return 500 on PHP-FPM / CGI hosts.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

Options -Indexes
