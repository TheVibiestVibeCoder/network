# Settings for the CRM MCP server.
#
# Easiest: do not edit this by hand - run  python3 scripts/setup.py  on the
# server, which asks a few questions and writes .env for you.
# This file only shows what .env contains.

# The address of this server, without https://
MCP_DOMAIN=mcp.disinfocombat.eu

# Your email address, for the free HTTPS certificate (Let's Encrypt).
ACME_EMAIL=you@example.eu

# The CRM's API endpoint.
CRM_API_URL=https://network.disinfocombat.eu/api/mcp.php

# Shared secret with the CRM: the SAME value as MCP_API_SECRET in the CRM's .env.
# Create with:  openssl rand -hex 32
CRM_API_SECRET=

# Hash of the password you sign in with when connecting Claude (not the password
# itself). scripts/setup.py creates it. Keep the single quotes.
LOGIN_PASSWORD_HASH=''

# Optional second factor: a base32 secret for an authenticator app. Empty = off.
TOTP_SECRET=

# Extra addresses that may reach the MCP endpoints besides Anthropic's servers
# (space-separated IPs or ranges). Leave empty unless you know you need it.
EXTRA_ALLOWED_IPS=

# true = Claude can only read, never propose changes.
READ_ONLY=false

LOG_LEVEL=INFO

# Token lifetimes in seconds (defaults: 1 hour / 30 days).
# ACCESS_TOKEN_TTL=3600
# REFRESH_TOKEN_TTL=2592000
