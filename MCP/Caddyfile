# Caddy in front of the MCP server:
#   - gets and renews the HTTPS certificate by itself (Let's Encrypt),
#   - decides who may reach what.
#
# Your browser must reach the sign-in page and the upload page from wherever
# you are. Everything else - the MCP endpoint itself, the token exchange,
# client registration and the OAuth metadata - is called by Anthropic's
# servers only, so it is open to Anthropic's published range and nobody else.
# Anthropic's outbound range: https://platform.claude.com/docs/en/api/ip-addresses
{
	email {$ACME_EMAIL}
}

{$MCP_DOMAIN} {
	@browser path /authorize /login /upload
	@anthropic remote_ip 160.79.104.0/21 {$EXTRA_ALLOWED_IPS}

	request_body {
		max_size 60MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	handle @browser {
		reverse_proxy mcp:8000
	}

	handle @anthropic {
		reverse_proxy mcp:8000
	}

	handle {
		respond 404
	}
}
