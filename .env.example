# CRM System Configuration
# Copy this file to .env and set your password.
#
# SECURITY: .env holds the only credential protecting the whole CRM.
#  - Never commit it (.gitignore already excludes it).
#  - Keep it out of the web root's reach: the shipped .htaccess denies it, but
#    on nginx you must deny it in the server block yourself.
#  - Better still: put it in a folder called crm-private directly next to the
#    web root. The app then reads .env from there and keeps data/ and its error
#    log there too, where no URL can reach them. See SECURITY.md.

# --- Password -----------------------------------------------------------------
# Strongly recommended: store a HASH, not the plain password, so that a leaked
# .env does not immediately hand over access. Generate one with:
#
#   php -r "echo password_hash('your-strong-password', PASSWORD_DEFAULT), PHP_EOL;"
#
# and paste the resulting $2y$... string below. A plain value still works for
# backwards compatibility, but is compared as-is.
#
# The application refuses to start while this is empty or a known placeholder
# such as "changeme".
APP_PASSWORD=

# Application Settings
APP_NAME="Simple CRM"

# --- Optional security/session tuning ----------------------------------------
# SESSION_LIFETIME    Absolute session lifetime in seconds (default 86400 = 24h).
# SESSION_IDLE_TIMEOUT Log out after this many seconds without a request.
#                     Defaults to SESSION_LIFETIME, i.e. disabled. 1800 = 30 min.
# MAX_LOGIN_ATTEMPTS  Failed attempts per IP before lockout (default 10).
# LOGIN_LOCKOUT_DURATION  Lockout length in seconds (default 900 = 15 min).
# TRUST_PROXY_HEADERS Set to true ONLY when a reverse proxy you control sets
#                     X-Forwarded-For / X-Forwarded-Proto. If it is true and no
#                     such proxy exists, clients can spoof their IP and defeat
#                     the login lockout.
# SESSION_LIFETIME=86400
# SESSION_IDLE_TIMEOUT=1800
# MAX_LOGIN_ATTEMPTS=5
# LOGIN_LOCKOUT_DURATION=900
# TRUST_PROXY_HEADERS=false

# --- Multi-user --------------------------------------------------------------
# The owner account IS the APP_PASSWORD above. It has no database row, is
# always an administrator, and is how you sign in when no user account works:
# leave the email field on the sign-in form empty.
# OWNER_NAME shows next to that identity in the header and on attribution.
# OWNER_NAME=Owner

# Everyone else is invited from the Users panel and chooses their own password
# through an emailed one-time link.
# INVITE_TOKEN_LIFETIME  How long an invite link stays valid (seconds, default 172800 = 48h).
# RESET_TOKEN_LIFETIME   How long a reset link stays valid (seconds, default 3600 = 1h).
# MIN_PASSWORD_LENGTH    Minimum length for a user-chosen password (default 10).
# INVITE_TOKEN_LIFETIME=172800
# RESET_TOKEN_LIFETIME=3600
# MIN_PASSWORD_LENGTH=10

# --- Two-factor sign-in ------------------------------------------------------
# A user account's password is not enough on its own: a one-time code goes to
# its registered address and has to be typed back. Set TWO_FACTOR_ENABLED=false
# to turn that off entirely.
#
# The OWNER login is deliberately exempt. It has no registered address, and it
# is the way back in when mail, the database or an account is broken - putting
# it behind a mail server would make the recovery path depend on the thing most
# likely to be down.
#
# This means outgoing mail has to work before you invite anyone: an account
# whose code cannot be delivered cannot sign in. Test it with a user account of
# your own before inviting colleagues. On localhost, where mail() usually does
# nothing, the code is shown on the sign-in screen instead - only ever for
# requests coming from the machine itself.
#
# LOGIN_CODE_LIFETIME      How long a code stays valid (seconds, default 600).
# LOGIN_CODE_MAX_ATTEMPTS  Wrong guesses before the challenge is thrown away (default 5).
# LOGIN_CODE_MAX_PER_HOUR  Codes one account may request per hour (default 10).
# LOGIN_CODE_MAX_FAILURES_PER_DAY
#                          Wrong codes an account may enter in 24 hours before it is
#                          sent no more (default 20). Reset by a correct code or a
#                          password change.
# TWO_FACTOR_ENABLED=true
# LOGIN_CODE_LIFETIME=600
# LOGIN_CODE_MAX_ATTEMPTS=5
# LOGIN_CODE_MAX_PER_HOUR=10
# LOGIN_CODE_MAX_FAILURES_PER_DAY=20

# --- "Keep me signed in on this device" ---------------------------------------
# An opt-in cookie that reopens the session without password or code. It is a
# second key to the account, so treat its lifetime as how long a stolen laptop
# stays useful. It is dropped on sign-out, when the password changes, and if the
# same cookie is ever presented twice.
#
# REMEMBER_ME_LIFETIME      How long the cookie lasts, counted from the sign-in that set
#                           it - using it does not extend it (seconds, default 604800 = 7 days).
# REMEMBER_ROTATION_GRACE   Seconds a just-replaced cookie stays acceptable, so the
#                           parallel requests of one page load are not mistaken for
#                           a replayed cookie (default 60). Lower is stricter.
# REMEMBER_ME_ENABLED=true
# REMEMBER_ME_LIFETIME=604800
# REMEMBER_ROTATION_GRACE=60

# --- Outgoing mail -----------------------------------------------------------
# Used for invite and password-reset links. MAIL_FROM must be an address on a
# domain this server is allowed to send for, or the mails bounce or land in
# spam. If mail cannot be sent at all, the Users panel still shows the link so
# an admin can pass it on by hand - nothing breaks, it just needs a copy/paste.
# MAIL_FROM=noreply@your-domain.tld
# MAIL_FROM_NAME="Simple CRM"

# Public base URL used to build those links. Auto-detected from the request
# when empty; set it explicitly behind a reverse proxy or in a subdirectory.
# APP_BASE_URL=https://your-domain.tld

# --- Optional SQLite performance tuning --------------------------------------
# SQLITE_BUSY_TIMEOUT_MS=5000
# SQLITE_CACHE_SIZE_KB=20000

# --- MCP API: letting Claude read and propose changes ------------------------
# api/mcp.php is the door Claude's MCP server uses. It is CLOSED unless
# MCP_API_ENABLED is true, MCP_API_SECRET is set and the caller's address is on
# MCP_API_ALLOWED_IPS. To everybody else it answers a bare 404.
#
# Nothing Claude writes becomes permanent on its own: every new record and
# every change waits in "From Claude" until someone on the team accepts it.
#
# MCP_API_SECRET       Shared key, at least 64 characters. Create it on the MCP
#                      server with:  openssl rand -hex 32
#                      and put the SAME value in the MCP server's .env.
# MCP_API_ALLOWED_IPS  Comma-separated IPs / CIDR ranges of the MCP server.
#                      Checked against the real connection address only.
# MCP_API_ALLOW_WRITES false = Claude can only read.
# MCP_API_RATE_LIMIT   Signed requests per minute (default 120).
# MCP_API_MAX_PENDING  Open proposals before new ones are refused (default 200).
# MCP_ACTOR_NAME       Name shown on everything written through the API.
# MCP_API_ENABLED=false
# MCP_API_SECRET=
# MCP_API_ALLOWED_IPS=2.28.118.11,2a01:4f8:1c1e:9d04::/64
# MCP_API_ALLOW_WRITES=true
# MCP_API_RATE_LIMIT=120
# MCP_API_MAX_PENDING=200
# MCP_ACTOR_NAME=Claude
