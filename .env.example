# CRM System Configuration
# Copy this file to .env and set your password.
#
# SECURITY: .env holds the only credential protecting the whole CRM.
#  - Never commit it (.gitignore already excludes it).
#  - Keep it out of the web root's reach: the shipped .htaccess denies it, but
#    on nginx you must deny it in the server block yourself.

# --- Password -----------------------------------------------------------------
# Strongly recommended: store a HASH, not the plain password, so that a leaked
# .env does not immediately hand over access. Generate one with:
#
#   php -r "echo password_hash('your-strong-password', PASSWORD_DEFAULT), PHP_EOL;"
#
# and paste the resulting $2y$... string below. A plain value still works for
# backwards compatibility, but is compared as-is.
#
# The application refuses to start while this is empty or a known placeholder
# such as "changeme".
APP_PASSWORD=

# Application Settings
APP_NAME="Simple CRM"

# --- Optional security/session tuning ----------------------------------------
# SESSION_LIFETIME    Absolute session lifetime in seconds (default 86400 = 24h).
# SESSION_IDLE_TIMEOUT Log out after this many seconds without a request.
#                     Defaults to SESSION_LIFETIME, i.e. disabled. 1800 = 30 min.
# MAX_LOGIN_ATTEMPTS  Failed attempts per IP before lockout (default 10).
# LOGIN_LOCKOUT_DURATION  Lockout length in seconds (default 900 = 15 min).
# TRUST_PROXY_HEADERS Set to true ONLY when a reverse proxy you control sets
#                     X-Forwarded-For / X-Forwarded-Proto. If it is true and no
#                     such proxy exists, clients can spoof their IP and defeat
#                     the login lockout.
# SESSION_LIFETIME=86400
# SESSION_IDLE_TIMEOUT=1800
# MAX_LOGIN_ATTEMPTS=5
# LOGIN_LOCKOUT_DURATION=900
# TRUST_PROXY_HEADERS=false

# --- Multi-user --------------------------------------------------------------
# The owner account IS the APP_PASSWORD above. It has no database row, is
# always an administrator, and is how you sign in when no user account works:
# leave the email field on the sign-in form empty.
# OWNER_NAME shows next to that identity in the header and on attribution.
# OWNER_NAME=Owner

# Everyone else is invited from the Users panel and chooses their own password
# through an emailed one-time link.
# INVITE_TOKEN_LIFETIME  How long an invite link stays valid (seconds, default 172800 = 48h).
# RESET_TOKEN_LIFETIME   How long a reset link stays valid (seconds, default 3600 = 1h).
# MIN_PASSWORD_LENGTH    Minimum length for a user-chosen password (default 10).
# INVITE_TOKEN_LIFETIME=172800
# RESET_TOKEN_LIFETIME=3600
# MIN_PASSWORD_LENGTH=10

# --- Outgoing mail -----------------------------------------------------------
# Used for invite and password-reset links. MAIL_FROM must be an address on a
# domain this server is allowed to send for, or the mails bounce or land in
# spam. If mail cannot be sent at all, the Users panel still shows the link so
# an admin can pass it on by hand - nothing breaks, it just needs a copy/paste.
# MAIL_FROM=noreply@your-domain.tld
# MAIL_FROM_NAME="Simple CRM"

# Public base URL used to build those links. Auto-detected from the request
# when empty; set it explicitly behind a reverse proxy or in a subdirectory.
# APP_BASE_URL=https://your-domain.tld

# --- Optional SQLite performance tuning --------------------------------------
# SQLITE_BUSY_TIMEOUT_MS=5000
# SQLITE_CACHE_SIZE_KB=20000
